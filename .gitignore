# machine memory — committed by every run, never edit by hand
# (state.json AND state.json.bak both live in git: two rungs of the
# memory-recovery ladder)

# scratch
work/
bank/
*.mp4
!ingest/*.mp4
*.wav
!docs/sample-short.jpg

# python bytecode
__pycache__/
*.pyc

# never commit cookies or keys
cookies.txt
*.secret
.env
client_secret*.json
